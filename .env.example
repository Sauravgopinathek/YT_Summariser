# ==========================================
# NVIDIA NIM API Configuration
# ==========================================
# Get your free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA NIM OpenAI-compatible Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Selected LLM Model from NVIDIA Catalog
# Examples:
# meta/llama-3.1-70b-instruct
# meta/llama-3.1-8b-instruct
# mistralai/mixtral-8x7b-instruct-v0.1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Model Inference Hyperparameters
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048

# Chunking Configuration
DEFAULT_CHUNK_SIZE_WORDS=800
DEFAULT_CHUNK_OVERLAP_WORDS=100
